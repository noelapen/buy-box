{
  "manifest_version": 3,
  "name": "BLACK BOX",
  "version": "1.0.0",
  "description": "IR-based shopping comparison with TF-IDF relevance.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*",
    "https://*.ebay.com/*",
    "https://*.ebay.in/*",
    "https://*.walmart.com/*",
    "https://*.target.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open BLACK BOX"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*",
        "https://*.ebay.com/*",
        "https://*.ebay.in/*",
        "https://*.walmart.com/*",
        "https://*.target.com/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
