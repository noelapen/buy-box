{
  "manifest_version": 3,
  "name": "BUY BOX",
  "version": "1.0.0",
  "description": "Compare the same product across shopping platforms.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*",
    "https://*.ebay.com/*",
    "https://*.ebay.in/*",
    "https://*.walmart.com/*",
    "https://*.target.com/*",
    "https://*.myntra.com/*",
    "https://*.ajio.com/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open BUY BOX"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*",
        "https://*.ebay.com/*",
        "https://*.ebay.in/*",
        "https://*.walmart.com/*",
        "https://*.target.com/*",
        "https://*.myntra.com/*",
        "https://*.ajio.com/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "assets/*"],
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*",
        "https://*.ebay.com/*",
        "https://*.ebay.in/*",
        "https://*.walmart.com/*",
        "https://*.target.com/*",
        "https://*.myntra.com/*",
        "https://*.ajio.com/*"
      ]
    }
  ]
}
